# ==========================================
# 1. AI Agents & Local Assistants
# ==========================================
.agents/
.claude/
.gemini/

# ==========================================
# 2. Terraform (Bảo mật state & secrets)
# ==========================================
# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data & credentials
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you do want to add if needed
# !example_override.tf

# CLI configuration files
.terraformrc
terraform.rc

# ==========================================
# 3. Environment Variables & Credentials
# ==========================================
.env
.env.*
!.env.example
*.pem
*.key

# ==========================================
# 4. OS & IDE Configuration
# ==========================================
.DS_Store
Thumbs.db
desktop.ini

.idea/
*.swp
*.swo

# VSCode
.vscode/

# ==========================================
# 5. Logs & Temporary Files
# ==========================================
*.log
*.zip
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Personal notes & runtime local data
member1.md
member*.md
node_modules/
backend/media-data.json
