# ==============================================================================
# THÔNG SỐ CẤU HÌNH FINOPS & IAM (SAO CHÉP THÀNH terraform.tfvars ĐỂ SỬ DỤNG)
# ==============================================================================

aws_region   = "ap-southeast-1"
project_name = "enterprise-cloud-devsecops"
environment  = "production"

# Ngân sách và các ngưỡng cảnh báo ($ USD)
budget_limit_usd                 = "200.0"
alert_threshold_1_percent        = 10.0   # $20 USD
alert_threshold_2_percent        = 25.0   # $50 USD (Khẩn cấp)
alert_threshold_forecast_percent = 80.0   # $160 USD

# Điền danh sách email thực tế của nhóm để nhận cảnh báo tự động
notification_emails = [
  "minhquan10092006@gmail.com",
  "hungpham@example.com"
]

# Tùy chỉnh tên người dùng IAM nếu cần thiết
member_users = {
  member1 = {
    username = "member1-network-iac"
    role     = "Network and Infrastructure as Code Lead"
  }
  member2 = {
    username = "member2-compute-container"
    role     = "Compute and Container Specialist"
  }
  member3 = {
    username = "member3-data-finops"
    role     = "Database Storage and FinOps Specialist"
  }
  member4 = {
    username = "member4-security-devsecops"
    role     = "Security Compliance and DevSecOps Specialist"
  }
}

# ==============================================================================
# TUẦN 2: CẤU HÌNH RDS MYSQL & S3 (MEMBER 3 — DỮ LIỆU & FINOPS)
# ==============================================================================

# --- Thông số nhận bàn giao từ Member 1 ---
# Lấy giá trị bằng lệnh: cd terraform/ && terraform output
vpc_id                   = "vpc-xxxxxxxxx"                              # Điền VPC ID thực từ Member 1 (terraform output vpc_id)
rds_db_subnet_group_name = "enterprise-cloud-devsecops-db-subnet-group" # Từ Member 1 (terraform output rds_db_subnet_group_name)
db_security_group_id     = ""                                           # Từ Member 1 (terraform output db_security_group_id) — Để trống sẽ tự tạo SG
private_app_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24"]

# --- RDS MySQL (FinOps Optimized) ---
rds_engine_version        = "8.0"
rds_instance_class        = "db.t3.micro" # FinOps: ~$0.018/hr | Nhớ STOP khi không dùng!
rds_allocated_storage     = 20            # 20 GB gp2 khởi tạo
rds_max_allocated_storage = 50            # Auto-scale tối đa 50 GB
rds_db_name               = "appdb"       # Khớp với backend/server.js của Member 2
rds_master_username       = "admin"
rds_master_password       = "YOUR_STRONG_PASSWORD_HERE" # Mật khẩu admin RDS
rds_multi_az              = false                       # false = tiết kiệm (dev/test) | true = bật khi demo bảo vệ đồ án

# ==============================================================================
# TUẦN 3: CẤU HÌNH DYNAMODB & S3 GLACIER (MEMBER 3 — DỮ LIỆU & FINOPS)
# ==============================================================================

# DynamoDB Billing: PAY_PER_REQUEST (On-Demand — tối ưu FinOps không tốn chi phí rảnh)
dynamodb_billing_mode = "PAY_PER_REQUEST"
dynamodb_enable_pitr  = false # Bật true khi diễn tập demo bảo vệ đồ án

# S3 Lifecycle: Tự động chuyển đổi tài liệu sang S3 Glacier để tiết kiệm > 84% chi phí
s3_glacier_transition_days            = 30 # Chuyển sang Glacier sau 30 ngày
s3_noncurrent_version_expiration_days = 90 # Xóa phiên bản cũ sau 90 ngày

# ==============================================================================
# TUẦN 4: CẤU HÌNH CLOUDWATCH & CLOUDTRAIL (MEMBER 3 — DỮ LIỆU & FINOPS)
# ==============================================================================

# Ngưỡng kích hoạt cảnh báo CPU (%) cho RDS & Container
cpu_utilization_alarm_threshold = 70.0

# FinOps Guardrail: Giữ log trong CloudWatch 7 ngày (tránh phình chi phí lưu trữ)
cloudwatch_log_retention_days = 7

# CloudTrail Audit S3 Lifecycle (Tiết kiệm > 84% chi phí lưu trữ vết kiểm toán)
cloudtrail_s3_glacier_transition_days = 30 # Chuyển sang S3 Glacier sau 30 ngày
cloudtrail_s3_retention_days          = 90 # Tự động xóa audit log sau 90 ngày

# CloudTrail Multi-Region (false = tối ưu chi phí trong region ap-southeast-1)
cloudtrail_is_multi_region = false

# ==============================================================================
# TUẦN 5: AMAZON REDSHIFT SERVERLESS (EPHEMERAL DEMO 1-2 GIỜ)
# ==============================================================================
# FinOps Safety Guardrail: Mặc định tắt (false) để tránh phát sinh chi phí ngầm.
# Chỉ bật = true khi chạy demo phân tích (demo_redshift.ps1), sau đó tắt = false ngay.
enable_redshift_demo = false

# Mức RPU cơ sở tối thiểu (8 RPU) - Tối ưu chi phí cho môi trường demo (~$3/giờ)
redshift_base_capacity_rpu = 8

# Tên database phân tích và tài khoản quản trị Redshift
redshift_db_name        = "analytics_db"
redshift_admin_username = "redshiftadmin"
redshift_admin_password = "DemoRedshift2026!Pass"

