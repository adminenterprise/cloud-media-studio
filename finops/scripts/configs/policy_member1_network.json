{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowVpcAndNetworkingManagement",
      "Effect": "Allow",
      "Action": [
        "ec2:*Vpc*",
        "ec2:*Subnet*",
        "ec2:*RouteTable*",
        "ec2:*Route*",
        "ec2:*InternetGateway*",
        "ec2:*NatGateway*",
        "ec2:*Address*",
        "ec2:*SecurityGroup*",
        "ec2:*NetworkAcl*",
        "ec2:*VpcPeeringConnection*",
        "ec2:*TransitGateway*",
        "ec2:*VpcEndpoint*",
        "ec2:Describe*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowLoadBalancerManagement",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowDnsAndCdnManagement",
      "Effect": "Allow",
      "Action": [
        "route53:*",
        "route53domains:*",
        "cloudfront:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowWafAssociationOnly",
      "Effect": "Allow",
      "Action": [
        "wafv2:Get*",
        "wafv2:List*",
        "wafv2:AssociateWebACL",
        "wafv2:DisassociateWebACL"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowTerraformStateAccess",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetObject",
        "s3:PutObject",
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": [
        "arn:aws:s3:::*terraform-state*",
        "arn:aws:s3:::*terraform-state*/*",
        "arn:aws:dynamodb:*:*:table/*terraform-locks*"
      ]
    }
  ]
}
