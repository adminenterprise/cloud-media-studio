{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowRelationalAndNoSqlDatabaseManagement",
      "Effect": "Allow",
      "Action": [
        "rds:*",
        "rds-data:*",
        "rds-db:*",
        "dynamodb:*",
        "dax:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowObjectStorageAndArchivingManagement",
      "Effect": "Allow",
      "Action": [
        "s3:*",
        "glacier:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowDataAnalyticsManagement",
      "Effect": "Allow",
      "Action": [
        "redshift-serverless:*",
        "redshift:*",
        "redshift-data:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowObservabilityAndAuditManagement",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:*",
        "logs:*",
        "cloudtrail:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowFinOpsAndCostManagement",
      "Effect": "Allow",
      "Action": [
        "budgets:*",
        "ce:*",
        "cur:*",
        "pricing:*",
        "aws-portal:ViewBilling",
        "aws-portal:ViewUsage"
      ],
      "Resource": "*"
    }
  ]
}
