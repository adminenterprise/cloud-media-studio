{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowWafManagement",
      "Effect": "Allow",
      "Action": [
        "wafv2:*",
        "waf:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowSecretsAndKeyManagement",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:*",
        "kms:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowCognitoAuthenticationManagement",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:*",
        "cognito-identity:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowEventMessagingManagement",
      "Effect": "Allow",
      "Action": [
        "sqs:*",
        "sns:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowCiCdRoleAndPolicyManagement",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:CreateRole",
        "iam:PutRolePolicy",
        "iam:AttachRolePolicy",
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::*:role/*github-actions*",
        "arn:aws:iam::*:role/*cicd*",
        "arn:aws:iam::*:role/*trivy*"
      ]
    }
  ]
}
