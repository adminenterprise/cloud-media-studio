{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowEc2AndAutoScalingManagement",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances",
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:RestartInstances",
        "ec2:TerminateInstances",
        "ec2:Describe*",
        "ec2:CreateLaunchTemplate*",
        "ec2:ModifyLaunchTemplate*",
        "ec2:DeleteLaunchTemplate*",
        "ec2:CreateKeyPair",
        "ec2:DeleteKeyPair",
        "ec2:DescribeKeyPairs",
        "autoscaling:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowContainerServicesManagement",
      "Effect": "Allow",
      "Action": [
        "ecs:*",
        "ecr:*",
        "elasticfilesystem:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowServerlessAndAppPlatforms",
      "Effect": "Allow",
      "Action": [
        "lambda:*",
        "elasticbeanstalk:*",
        "lightsail:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowPassRoleForCompute",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::*:role/*ecsTaskExecutionRole*",
      "Condition": {
        "StringLike": {
          "iam:PassedToService": [
            "ecs-tasks.amazonaws.com",
            "ec2.amazonaws.com",
            "lambda.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "AllowDynamoDbSessionAndCartAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:Query",
        "dynamodb:Scan"
      ],
      "Resource": [
        "arn:aws:dynamodb:*:*:table/*user-sessions*",
        "arn:aws:dynamodb:*:*:table/*user-sessions*/index/*",
        "arn:aws:dynamodb:*:*:table/*cart*",
        "arn:aws:dynamodb:*:*:table/*cart*/index/*"
      ]
    }
  ]
}
